# Environment + secrets — never commit
.env
*.env
*.pem
*.key
*.p12
walletpassword

# Python build/cache
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/

# Node.js — integrations have node_modules but those don't belong in git
node_modules/
package-lock.json.bak
.npm/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Runtime data — never commit, ever
data/*
# Exception: explicitly public, non-secret registries meant to be independently checkable
# (git history IS the as-of audit trail a verifier checks a content hash against — see the
# file's own _doc field). Never add a broad data/ carve-out here, one file at a time only.
# (git ignores a file inside an excluded directory even if negated below the parent pattern
# unless the parent uses data/* rather than data/ -- that's why this changed from data/.)
!data/independent_mediators_registry.json
*.db
*.db-journal
*.db-wal
*.db-shm
*.jsonl
# Attribution-ledger validator conformance fixtures -- committed test data, not
# generated output; same one-file-at-a-time negation convention as above.
!proposals/attribution-ledger/fixtures/*.jsonl
*.log
